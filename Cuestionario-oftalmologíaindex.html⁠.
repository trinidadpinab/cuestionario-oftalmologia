<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cuestionario Interactivo de Oftalmología 2024</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-50 text-slate-800 font-sans min-p-4">
    <div class="max-w-4xl mx-auto p-4 sm:p-6 my-8 bg-white rounded-2xl shadow-xl border border-slate-100">
        <!-- Header -->
        <header class="text-center pb-6 border-b border-slate-100 mb-6">
            <h1 class="text-2xl sm:text-3xl font-extrabold text-blue-900 tracking-tight">Oftalmología 2024 - Cuestionario de Estudio</h1>
            <p class="text-sm text-slate-500 mt-1">Basado en el documento oficial de clases (Trinidad Medina)</p>
        </header>

        <!-- Configuración Inicial / Menú -->
        <div id="setup-screen" class="space-y-6">
            <div class="bg-blue-50 p-4 rounded-xl border border-blue-100">
                <h2 class="font-bold text-blue-900 mb-2">Instrucciones de Estudio:</h2>
                <ul class="text-sm text-blue-800 space-y-1 list-disc list-inside">
                    <li>Selecciona el modo de estudio y la clase que deseas repasar.</li>
                    <li>Las preguntas incluyen razonamiento clínico, casos y conceptos de alto rendimiento.</li>
                    <li>Tu progreso se guarda automáticamente en tu dispositivo.</li>
                </ul>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-semibold text-slate-700 mb-1">Seleccionar Clase:</label>
                    <select id="class-select" class="w-full p-3 border border-slate-300 rounded-xl focus:ring-2 focus:ring-blue-500 bg-white">
                        <option value="all">📚 Todas las clases (Simulacro completo)</option>
                        <option value="anatomia">1. Anatomía Ocular</option>
                        <option value="semiologia">2. Semiología Ocular</option>
                        <option value="catarata">3. Catarata</option>
                        <option value="glaucoma">4. Glaucoma</option>
                        <option value="superficie">5. Patología de la Superficie Ocular</option>
                        <option value="fondo">6. Fondo de Ojo y Oftalmoscopía</option>
                        <option value="orbita">7. Patología Orbitaria</option>
                        <option value="refraccion">8. Vicios de Refracción</option>
                        <option value="aguda">9. Pérdida de Visión Aguda</option>
                        <option value="pediatrica">10-11. Oftalmología Pediátrica y Leucocoria</option>
                        <option value="trauma">12. Trauma Ocular</option>
                        <option value="retinopatia_diabetica">13. Retinopatía Diabética</option>
                        <option value="retinopatia_hipertensiva">14. Retinopatía Hipertensiva</option>
                        <option value="genetica">15. Enfermedades Genéticas y Sistémicas</option>
                        <option value="ojo_rojo">16. Síndrome Ojo Rojo</option>
                        <option value="neuro">17. Neurooftalmología</option>
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-semibold text-slate-700 mb-1">Modo de Estudio:</label>
                    <select id="mode-select" class="w-full p-3 border border-slate-300 rounded-xl focus:ring-2 focus:ring-blue-500 bg-white">
                        <option value="study">Modo Estudio (Feedback inmediato y explicación)</option>
                        <option value="exam">Modo Examen (Resultados al finalizar)</option>
                    </select>
                </div>
            </div>

            <div class="flex gap-4 pt-4">
                <button onclick="startQuiz()" class="flex-1 bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 px-6 rounded-xl transition shadow-lg shadow-blue-200">Comenzar Cuestionario</button>
                <button onclick="resetProgress()" class="bg-slate-200 hover:bg-slate-300 text-slate-700 font-semibold py-3 px-4 rounded-xl transition text-sm">Borrar Progreso Guardado</button>
            </div>
        </div>

        <!-- Pantalla de Preguntas -->
        <div id="quiz-screen" class="hidden space-y-6">
            <!-- Barra de Progreso y Estadísticas -->
            <div class="flex flex-wrap justify-between items-center text-xs sm:text-sm font-medium text-slate-500 bg-slate-100 p-3 rounded-xl">
                <span id="progress-indicator">Pregunta 1 de 10</span>
                <div class="flex gap-3">
                    <span class="text-emerald-600 font-bold">Correctas: <span id="stat-correct">0</span></span>
                    <span class="text-rose-600 font-bold">Incorrectas: <span id="stat-incorrect">0</span></span>
                    <span class="text-blue-600 font-bold">Rendimiento: <span id="stat-score">0%</span></span>
                </div>
            </div>

            <!-- Tarjeta de Pregunta -->
            <div class="bg-white border border-slate-200 p-6 rounded-2xl shadow-sm">
                <span id="question-category" class="inline-block bg-blue-100 text-blue-800 text-xs font-semibold px-2.5 py-1 rounded-full mb-3">Clase</span>
                <h3 id="question-text" class="text-lg sm:text-xl font-bold text-slate-900 mb-6">Texto de la pregunta...</h3>
                
                <div id="options-container" class="space-y-3">
                    <!-- Opciones inyectadas por JS -->
                </div>
            </div>

            <!-- Botón Comprobar / Siguiente -->
            <div id="action-container" class="flex justify-end">
                <button id="submit-btn" onclick="checkAnswer()" class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 px-8 rounded-xl transition shadow-md hidden">Comprobar Respuesta</button>
                <button id="next-btn" onclick="nextQuestion()" class="bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-3 px-8 rounded-xl transition shadow-md hidden">Siguiente Pregunta ➔</button>
            </div>

            <!-- Explicación y Feedback -->
            <div id="explanation-box" class="hidden p-5 rounded-xl border transition-all">
                <h4 id="explanation-title" class="font-bold text-base mb-1">Feedback</h4>
                <p id="explanation-text" class="text-sm leading-relaxed"></p>
            </div>
        </div>

        <!-- Pantalla de Resultados -->
        <div id="results-screen" class="hidden text-center space-y-6 py-6">
            <h2 class="text-3xl font-extrabold text-slate-900">¡Sesión Finalizada! 🎉</h2>
            <div class="max-w-md mx-auto bg-slate-50 p-6 rounded-2xl border border-slate-200 space-y-3">
                <p class="text-lg">Calificación final: <span id="final-score" class="font-bold text-blue-600">0%</span></p>
                <p class="text-sm text-slate-600">Preguntas correctas: <span id="final-correct" class="font-bold text-emerald-600">0</span></p>
                <p class="text-sm text-slate-600">Preguntas incorrectas: <span id="final-incorrect" class="font-bold text-rose-600">0</span></p>
            </div>
            <div class="flex justify-center gap-4 pt-4">
                <button onclick="restartQuiz()" class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 px-6 rounded-xl transition">Volver al Menú</button>
            </div>
        </div>
    </div>

    <script>
        // Banco de preguntas clínico-exhaustivo basado fielmente en el PDF oficial
        const questionBank = [
            {
                classId: "anatomia",
                category: "Anatomía Ocular",
                difficulty: "Básica",
                question: "¿Cuál es la capa corneal más gruesa del estroma y qué función principal cumple el endotelio corneal?",
                options: [
                    "El epitelio corneal y su función es producir humor acuoso.",
                    "El estroma corneal (colágeno) y el endotelio remueve activamente agua para mantener la transparencia.",
                    "La membrana de Descemet y su función es la nutrición avascular.",
                    "La membrana de Bowman y su función es la regeneración celular rápida."
                ],
                correct: 1,
                explanation: "El estroma corneal es la capa más gruesa formada por colágeno. El endotelio corneal está formado por células que remueven el agua de la córnea para mantener su transparencia, y al envejecer no se regeneran."
            },
            {
                classId: "anatomia",
                category: "Anatomía Ocular",
                difficulty: "Intermedia",
                question: "Respecto a la vía del humor acuoso, ¿cuál es el trayecto fisiológico correcto desde su producción hasta su reabsorción?",
                options: [
                    "Cuerpo ciliar ➔ Cámara anterior ➔ Cámara posterior ➔ Canal de Schlemm",
                    "Cuerpo ciliar ➔ Cámara posterior ➔ Pupila ➔ Cámara anterior ➔ Malla trabecular ➔ Canal de Schlemm ➔ Venas epiesclerales",
                    "Cristalino ➔ Conducto de Schlemm ➔ Trabéculo ➔ Cámara anterior",
                    "Procesos ciliares ➔ Córnea ➔ Úvea ➔ Vena central de la retina"
                ],
                correct: 1,
                explanation: "El humor acuoso es producido por los cuerpos ciliares hacia la cámara posterior, pasa a través de la pupila a la cámara anterior, es filtrado por la malla trabecular en el ángulo iridocorneal y drenado por el canal de Schlemm hacia los vasos epiesclerales."
            },
            {
                classId: "catarata",
                category: "Catarata",
                difficulty: "Clínica",
                question: "Paciente diabético de 55 años presenta pérdida de visión bilateral de instauración más rápida que una catarata senil habitual, asociada a alteración metabólica por acumulación de sorbitol. ¿Cómo se denomina clásicamente a esta presentación?",
                options: [
                    "Catarata nuclear incipiente",
                    "Catarata en copo de nieve",
                    "Catarata subcapsular posterior",
                    "Ectopia lentis por síndrome de Marfan"
                ],
                correct: 1,
                explanation: "En pacientes con diabetes (especialmente DM1 mal controlada), la vía del sorbitol incrementa la presión oncótica por acumulación de sorbitol y fructosa, atrayendo agua y generando opacidades bilaterales características conocidas como 'cataratas en copo de nieve'."
            },
            {
                classId: "glaucoma",
                category: "Glaucoma",
                difficulty: "Difícil",
                question: "Mujer de 65 años, hipermétrope, consulta por cuadro clínico de dolor ocular intenso súbito, visión de halos alrededor de las luces, náuseas, vómitos, ojo rojo profundo y presión intraocular ≥ 40 mmHg con semimidriasis fija. ¿Cuál es el tratamiento médico inicial y el mecanismo fisiopatológico?",
                options: [
                    "Pilocarpina tópica y Timolol; bloqueo por exceso de producción de humor acuoso.",
                    "Manitol EV, Acetazolamida, Timolol y Pilocarpina; bloqueo pupilar por cámara anterior estrecha.",
                    "Corticoides tópicos y Midriáticos; apertura forzada del ángulo iridocorneal.",
                    "Trabeculectomía de emergencia sin tratamiento médico previo."
                ],
                correct: 1,
                explanation: "Corresponde a un glaucoma agudo por cierre angular. El mecanismo es el bloqueo pupilar por contacto entre el iris y el cristalino en una cámara estrecha. El manejo inicial de urgencia incluye Manitol EV (deshidrata vítreo), Acetazolamida, betabloqueadores y Pilocarpina, seguido de iridotomía láser definitiva."
            },
            {
                classId: "superficie",
                category: "Patología de la Superficie Ocular",
                difficulty: "Intermedia",
                question: "Un paciente acusa ojo rojo superficial, secreción purulenta abundante, pegamiento matutino de pestañas y ausencia de dolor o alteración de agudeza visual. ¿Cuál es el germen más frecuente y el manejo inicial?",
                options: [
                    "Adenovirus; aislamiento y lágrimas artificiales.",
                    "Staphylococcus aureus (Gram positivo); antibiótico tópico como Tobramicina o Eritromicina.",
                    "Neisseria gonorrhoeae; Ceftriaxona EV exclusiva.",
                    "Chlamydia trachomatis; tratamiento oral con aciclovir."
                ],
                correct: 1,
                explanation: "La conjuntivitis bacteriana aguda es predominantemente causada por Gram positivos como Staphylococcus aureus. Se caracteriza por secreción purulenta y se maneja con aseo y antibióticos tópicos (Tobramicina, Eritromicina, Ciprofloxacino)."
            },
            {
                classId: "trauma",
                category: "Trauma Ocular",
                difficulty: "Clínica",
                question: "Ante la sospecha fundamentada de un TRAUMA OCULAR ABIERTO (herida penetrante o estallido ocular), ¿cuál de las siguientes indicaciones constituye una contraindicación absoluta e inmediata en la atención inicial?",
                options: [
                    "Colocar un parche rígido protector sin presionar el globo ocular.",
                    "Administrar profilaxis antibiótica sistémica.",
                    "Aplicar colirios anestésicos o antibióticos tópicos directamente en el ojo.",
                    "Derivar en ayunas a un centro oftalmológico."
                ],
                correct: 2,
                explanation: "NUNCA se deben aplicar colirios tópicos en una herida penetrante ocular, ya que el líquido puede arrastrar gérmenes hacia el interior del ojo y agravar el daño estructural."
            },
            {
                classId: "retinopatia_diabetica",
                category: "Retinopatía Diabética",
                difficulty: "Intermedia",
                question: "En el fondo de ojo de un paciente diabético se observan múltiples microaneurismas, hemorragias intrarretinianas generalizadas en los 4 cuadrantes, rosarios venosos en dos o más cuadrantes y anomalías microvasculares intrarretinianas (IRMA). ¿Cómo se clasifica este cuadro?",
                options: [
                    "Retinopatía diabética no proliferativa leve",
                    "Retinopatía diabética no proliferativa severa",
                    "Retinopatía diabética proliferativa",
                    "Edema macular clínicamente significativo"
                ],
                correct: 1,
                explanation: "La presencia de al menos uno de los criterios de la regla 4-2-1 (≥20 hemorragias en 4 cuadrantes, rosarios venosos en ≥2 cuadrantes o IRMA en ≥1 cuadrante) define una retinopatía diabética no proliferativa severa."
            },
            {
                classId: "ojo_rojo",
                category: "Síndrome Ojo Rojo",
                difficulty: "Básica",
                question: "¿Qué signo clínico diferencia fundamentalmente un 'ojo rojo superficial' (conjuntivitis) de un 'ojo rojo profundo' (queratitis, uveítis o glaucoma agudo)?",
                options: [
                    "La presencia exclusiva de secreción purulenta.",
                    "La afectación del halo pericorneal limpio y ausencia de dolor en el superficial, frente a inyección ciliar, dolor y baja de agudeza visual en el profundo.",
                    "La dilatación de las venas vorticosas posteriores.",
                    "La respuesta inmediata a los vasoconstrictores tópicos."
                ],
                correct: 1,
                explanation: "El ojo rojo superficial respeta un halo blanco alrededor de la córnea, es indoloro y no altera la visión. El ojo rojo profundo muestra inyección periquerática (alrededor del limbo), dolor intenso, fotofobia y alteración visual."
            }
        ];

        let currentClass = "all";
        let studyMode = "study";
        let activeQuestions = [];
        let currentIndex = 0;
        let scoreCorrect = 0;
        let scoreIncorrect = 0;
        let selectedOption = null;
        let answered = false;

        // Cargar progreso guardado al iniciar
        window.onload = function() {
            const savedProgress = localStorage.getItem('oftmo_progress');
            if (savedProgress) {
                const data = JSON.parse(savedProgress);
                scoreCorrect = data.correct || 0;
                scoreIncorrect = data.incorrect || 0;
            }
        };

        function startQuiz() {
            currentClass = document.getElementById('class-select').value;
            studyMode = document.getElementById('mode-select').value;

            if (currentClass === "all") {
                activeQuestions = [...questionBank];
            } else {
                activeQuestions = questionBank.filter(q => q.classId === currentClass);
            }

            if (activeQuestions.length === 0) {
                alert("No hay suficientes preguntas para esta categoría en esta muestra. Selecciona 'Todas las clases'.");
                return;
            }

            // Mezclar preguntas aleatoriamente
            activeQuestions.sort(() => Math.random() - 0.5);

            currentIndex = 0;
            scoreCorrect = 0;
            scoreIncorrect = 0;

            document.getElementById('setup-screen').classList.add('hidden');
            document.getElementById('results-screen').classList.add('hidden');
            document.getElementById('quiz-screen').classList.remove('hidden');

            loadQuestion();
        }

        function loadQuestion() {
            answered = false;
            selectedOption = null;
            const q = activeQuestions[currentIndex];

            document.getElementById('progress-indicator').innerText = `Pregunta ${currentIndex + 1} de ${activeQuestions.length}`;
            document.getElementById('question-category').innerText = `${q.category} (${q.difficulty})`;
            document.getElementById('question-text').innerText = q.question;

            const optionsContainer = document.getElementById('options-container');
            optionsContainer.innerHTML = '';

            q.options.forEach((opt, index) => {
                const btn = document.createElement('button');
                btn.className = "w-full text-left p-4 rounded-xl border border-slate-200 hover:bg-blue-50 hover:border-blue-300 transition text-sm sm:text-base font-medium text-slate-700";
                btn.innerText = opt;
                btn.onclick = () => selectOption(index, btn);
                optionsContainer.appendChild(btn);
            });

            document.getElementById('submit-btn').classList.add('hidden');
            document.getElementById('next-btn').classList.add('hidden');
            document.getElementById('explanation-box').classList.add('hidden');
            updateStats();
        }

        function selectOption(index, element) {
            if (answered) return;
            selectedOption = index;
            
            // Remover selección previa
            Array.from(document.getElementById('options-container').children).forEach(btn => {
                btn.classList.remove('bg-blue-100', 'border-blue-500', 'text-blue-900');
            });

            // Marcar actual
            element.classList.add('bg-blue-100', 'border-blue-500', 'text-blue-900');
            document.getElementById('submit-btn').classList.remove('hidden');
        }

        function checkAnswer() {
            if (selectedOption === null || answered) return;
            answered = true;

            const q = activeQuestions[currentIndex];
            const options = document.getElementById('options-container').children;

            if (selectedOption === q.correct) {
                scoreCorrect++;
                options[selectedOption].classList.remove('bg-blue-100', 'border-blue-500', 'text-blue-900');
                options[selectedOption].classList.add('bg-emerald-100', 'border-emerald-500', 'text-emerald-900');
            } else {
                scoreIncorrect++;
                options[selectedOption].classList.remove('bg-blue-100', 'border-blue-500', 'text-blue-900');
                options[selectedOption].classList.add('bg-rose-100', 'border-rose-500', 'text-rose-900');
                options[q.correct].classList.add('bg-emerald-100', 'border-emerald-500', 'text-emerald-900');
            }

            saveProgress();
            updateStats();

            document.getElementById('submit-btn').classList.add('hidden');

            if (studyMode === 'study') {
                const expBox = document.getElementById('explanation-box');
                const expTitle = document.getElementById('explanation-title');
                const expText = document.getElementById('explanation-text');

                if (selectedOption === q.correct) {
                    expBox.className = "p-5 rounded-xl border bg-emerald-50 border-emerald-200 text-emerald-900";
                    expTitle.innerText = "¡Correcto! 🎯";
                } else {
                    expBox.className = "p-5 rounded-xl border bg-rose-50 border-rose-200 text-rose-900";
                    expTitle.innerText = "Incorrecto ❌";
                }
                expText.innerText = q.explanation;
                expBox.classList.remove('hidden');
            }

            document.getElementById('next-btn').classList.remove('hidden');
        }

        function nextQuestion() {
            currentIndex++;
            if (currentIndex < activeQuestions.length) {
                loadQuestion();
            } else {
                showResults();
            }
        }

        function showResults() {
            document.getElementById('quiz-screen').classList.add('hidden');
            document.getElementById('results-screen').classList.remove('hidden');

            const total = activeQuestions.length;
            const percentage = total > 0 ? Math.round((scoreCorrect / total) * 100) : 0;

            document.getElementById('final-score').innerText = `${percentage}%`;
            document.getElementById('final-correct').innerText = scoreCorrect;
            document.getElementById('final-incorrect').innerText = scoreIncorrect;
        }

        function updateStats() {
            const total = scoreCorrect + scoreIncorrect;
            const percentage = total > 0 ? Math.round((scoreCorrect / total) * 100) : 0;
            document.getElementById('stat-correct').innerText = scoreCorrect;
            document.getElementById('stat-incorrect').innerText = scoreIncorrect;
            document.getElementById('stat-score').innerText = `${percentage}%`;
        }

        function saveProgress() {
            localStorage.setItem('oftmo_progress', JSON.stringify({
                correct: scoreCorrect,
                incorrect: scoreIncorrect
            }));
        }

        function resetProgress() {
            localStorage.removeItem('oftmo_progress');
            scoreCorrect = 0;
            scoreIncorrect = 0;
            alert("Progreso borrado correctamente.");
        }

        function restartQuiz() {
            document.getElementById('results-screen').classList.add('hidden');
            document.getElementById('setup-screen').classList.remove('hidden');
        }
    </script>
</body>
</html>
